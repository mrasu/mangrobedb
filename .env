RUST_LOG=mangrobedb=debug
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin
AWS_REGION=us-east-1
AWS_ALLOW_HTTP=true

# MANGROBEDB settings can be configured via config files or environment variables.
# When using environment variables, prefix keys with MANGROBE_DB.
# Example:
# MANGROBEDB_S3__BUCKET=mangrobedb-development
